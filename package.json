{
  "name": "kushibot",
  "version": "0.0.0",
  "description": "TypeScript library for workflows and executors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:examples": "tsc -p tsconfig.examples.json",
    "example:shared-policy": "npm run build:examples && node .example-dist/examples/shared-policy/main.js",
    "example:configuration": "npm run build:examples && node .example-dist/examples/configuration/main.js",
    "example:lifecycle": "npm run build:examples && node .example-dist/examples/lifecycle/main.js",
    "test": "tsc -p tsconfig.tests.json && node tests/run-tests.mjs",
    "test:conversations": "npm run build && node tests/conversations/run-sql-acceptance.mjs",
    "test:conversations:postgres": "npm run build && node tests/conversations/run-sql-acceptance.mjs --postgres"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "joi": "^18.3.1"
  }
}
